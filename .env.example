# DeepSeek API key. Optional: if unset, report generation falls back to the deterministic
# simulator generator (see lib/deepseek.ts). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# Optional overrides — defaults are shown.
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/seoscan"

# JWT configuration.
# JWT_SECRET must be UNIQUE and RANDOM (>= 32 chars). The server refuses to start while it is
# still the placeholder below, because a guessable signing secret lets anyone mint a token for
# any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long!"
JWT_EXPIRY="7d"

# DEV ONLY. When "true", POST /api/auth/forgot-password includes the reset link in the JSON
# response so the flow can be exercised without an email provider. Never enable this on a host
# anyone else can reach — it is a one-request account takeover. Leave unset in production.
# RETURN_RESET_LINK_IN_RESPONSE="true"

# Email (Resend, https://resend.com). Used for password-reset emails and monitoring score-drop
# alerts. Both must be set to actually send; otherwise emails are skipped and only the subject is
# logged. EMAIL_FROM must be an address on a domain verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM="SEO Scan Pro <alerts@yourdomain.com>"

# Scan throttling. SCAN_CONCURRENCY = scans that run at once (each drives headless Chromium and a
# billed AI call). MAX_PENDING_SCANS = scans one account may have queued/running before POST /api/scan
# answers 429.
# SCAN_CONCURRENCY=2
# MAX_PENDING_SCANS=5

# Number of reverse-proxy hops in front of the app (Railway edge = 1). Drives req.ip for rate limits.
# TRUST_PROXY_HOPS=1

# Per-account daily allowance of manual scans (rolling 24 hours). Monitor re-scans are not counted.
# DAILY_SCAN_LIMIT=25

# Shown on the Terms and Privacy pages as the contact address. Optional: omitted when unset.
# SUPPORT_EMAIL=support@yourdomain.com
