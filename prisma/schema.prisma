// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  widgetKey String   @unique @default(cuid())
  // Bumped to invalidate every previously issued JWT ("log out everywhere", password change/reset).
  tokenVersion Int   @default(0)
  // Null until the owner clicks the link emailed at signup (or after an email change).
  emailVerifiedAt DateTime?
  // Billing. `plan` is what the account is entitled to right now (FREE | STARTER | AGENCY); it is
  // only ever changed by the Stripe webhook, never by the browser.
  plan                 String    @default("FREE")
  planStatus           String?   // Stripe subscription status: active | trialing | past_due | canceled | ...
  planInterval         String?   // month | year
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  scans        Scan[]
  settings     WhiteLabelSettings?
  resetTokens  PasswordResetToken[]
  verifyTokens EmailVerificationToken[]
  monitors     Monitor[]
  apiKeys      ApiKey[]

  @@map("users")
}

// Stripe retries webhooks and can deliver them twice or out of order; recording each event id makes
// handling idempotent.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  // The address the link proves ownership of; a stale link cannot verify a newer address.
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Scan {
  id        String   @id @default(cuid())
  url       String
  mode      String   @default("SINGLE") // SINGLE | FULL_SITE
  depth     Int      @default(1)
  status    String   @default("PENDING") // PENDING | COMPLETED | FAILED

  leadEmail String?
  leadName  String?

  // Set when a scheduled monitor (not a person) started this scan.
  monitorId String?
  monitor   Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  crawlData Json?
  seoReport Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([monitorId])
  @@map("scans")
}

model WhiteLabelSettings {
  id        String   @id @default(cuid())
  agencyName String  @default("SeoScan")
  logoUrl   String?
  primaryColor String @default("#3aa745")
  accentColor String @default("#06b6d4")
  customFooter String @default("Report provided by SeoScan • Powered by DeepSeek V4.")
  enabledSections String[] @default(["executive", "technical", "content", "aeo-geo", "checklist"])
  language  String  @default("en") // en | es
  webhookUrl String?
  webhookSecret String @default(cuid())
  monitoringEmail String?
  enableEmailAlerts Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("white_label_settings")
}

// A recurring re-scan of one URL. The scheduler (lib/scheduler.ts) picks up rows whose
// nextRunAt has passed, queues a scan, and emails an alert if the score regressed.
model Monitor {
  id          String    @id @default(cuid())
  url         String
  frequency   String    @default("WEEKLY") // DAILY | WEEKLY
  active      Boolean   @default(true)
  // Alert when the overall score falls by at least this many points versus the previous scan.
  alertDrop   Int       @default(5)
  lastRunAt   DateTime?
  nextRunAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans       Scan[]

  @@index([userId])
  @@index([active, nextRunAt])
  @@map("monitors")
}

// Programmatic access. Only the SHA-256 of the key is stored; the plaintext is shown once.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String    // first characters of the key, so a user can tell keys apart in a list
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
