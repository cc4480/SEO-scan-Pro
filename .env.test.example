# Copy to .env.test. Loaded by tests/setup.ts before anything else reads process.env.
# Unit tests (tests/unit) need nothing here: they fall back to a throwaway JWT_SECRET.
# Integration tests (tests/integration) need a throwaway PostgreSQL database that the tests may
# freely create and delete rows in. NEVER point this at a real database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seoscan_test"
JWT_SECRET="test-only-secret-not-used-anywhere-else-0123456789abcdef"
